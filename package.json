{
  "name": "employee-plus",
  "version": "0.1.0",
  "private": true,
  "description": "Employee+ consumer home-care concierge for Alexa+.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "pretest": "pnpm --filter @employee-plus/mcp-app build",
    "dev": "pnpm --filter @employee-plus/mcp-server dev",
    "demo": "pnpm --filter @employee-plus/video-demo dev",
    "demo:build": "pnpm --filter @employee-plus/video-demo build",
    "video:studio": "pnpm --filter @employee-plus/video-renderer studio",
    "video:voice": "pnpm --filter @employee-plus/video-renderer voice",
    "video:render": "pnpm --filter @employee-plus/video-renderer render",
    "video:typecheck": "pnpm --filter @employee-plus/video-renderer build",
    "format:check": "prettier --check packages/adapters/src/index.test.ts packages/domain/src/index.test.ts",
    "lint": "tsc -b --pretty false",
    "test": "vitest run --coverage",
    "test:mcp": "pnpm --filter @employee-plus/mcp-app build && node node_modules/typescript/bin/tsc -b --pretty false && node scripts/smoke-mcp.mjs",
    "test:remote": "node scripts/smoke-remote.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "3.2.7",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
