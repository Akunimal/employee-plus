{
  "name": "employee-plus",
  "version": "0.1.0",
  "private": true,
  "description": "Employee+ consumer home-care concierge for Alexa+.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @employee-plus/mcp-server dev",
    "format:check": "prettier --check .",
    "lint": "tsc -b --pretty false",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@vitest/coverage-v8": "3.2.7",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
